{
  "name": "airgap-architect-backend",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "author": "Bill Strauss",
  "contributors": [
    "Bill Strauss (primary developer)",
    "Claude AI (Anthropic) - development assistance",
    "Cursor AI - development assistance"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test:exact-binary": "NODE_ENV=test DATA_DIR=${DATA_DIR:-/tmp/airgap-backend-test-exact} AIRGAP_RUNTIME_PACKAGE_IMAGE_EXPORT_MODE=none node --test --test-concurrency=1 test-integration/*.test.js",
    "test": "NODE_ENV=test DATA_DIR=${DATA_DIR:-/tmp/airgap-backend-test} AIRGAP_RUNTIME_PACKAGE_IMAGE_EXPORT_MODE=${AIRGAP_RUNTIME_PACKAGE_IMAGE_EXPORT_MODE:-none} RUNTIME_PACKAGE_BACKEND_IMAGE=${RUNTIME_PACKAGE_BACKEND_IMAGE:-localhost/oaa-test-owned-backend:never-built} RUNTIME_PACKAGE_FRONTEND_IMAGE=${RUNTIME_PACKAGE_FRONTEND_IMAGE:-localhost/oaa-test-owned-frontend:never-built} node --test --test-concurrency=1 test/*.test.js",
    "test:parallel-diagnostic": "NODE_ENV=test DATA_DIR=${DATA_DIR:-/tmp/airgap-backend-test} node --test test/*.test.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^9.4.0",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "js-yaml": "^4.3.2",
    "nanoid": "^5.1.16",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "qs": "^6.16.0",
    "brace-expansion": "^5.0.12",
    "form-data": "^4.0.6"
  }
}
