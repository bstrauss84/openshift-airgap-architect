# Stage: compute APP_GIT_SHA and APP_BUILD_TIME
# .git is excluded by .dockerignore, so pass SHA from the host:
#   podman compose build --build-arg APP_GIT_SHA=$(git rev-parse HEAD)
FROM registry.access.redhat.com/ubi9/ubi-minimal AS build-info
ARG APP_GIT_SHA=unknown
RUN BT=$(date -u +"%Y-%m-%dT%H:%M:%SZ"); \
    echo "export APP_GIT_SHA=\"${APP_GIT_SHA}\"" > /tmp/build-env.sh && \
    echo "export APP_BUILD_TIME=\"$BT\"" >> /tmp/build-env.sh

# ---------------------------------------------------------------------------
# Builder — fetches oc/oc-mirror and compiles better-sqlite3, then is discarded
# ---------------------------------------------------------------------------
#
# WHY THIS STAGE EXISTS, AND WHAT THE REAL PROBLEM TURNED OUT TO BE
#
# This file used to be a SINGLE stage on ubi9/nodejs-22 whose runtime therefore
# carried the complete C/C++ build toolchain. The obvious theory was that the
# `dnf install ... python3 make gcc-c++ ...` line below was pulling that
# toolchain (and its `kernel-headers` dependency) into the shipped image.
#
# THAT THEORY IS WRONG, and the correction matters for future maintenance:
# `registry.access.redhat.com/ubi9/nodejs-22` is an S2I BUILDER image and
# already ships gcc, gcc-c++, cpp, make, python3, glibc-devel, libstdc++-devel,
# openssl-devel and kernel-headers out of the box. Measured on the pre-change
# image (ImageID sha256:7252836047c2…, built 2026-10-12): `rpm -qa` returned the
# same 302 packages as the bare base image, with IDENTICAL %{INSTALLTIME}
# values (2026-10-06/2026-10-08, i.e. Red Hat's base build, not ours). The dnf
# layer installed exactly ZERO new packages. Deleting that line, or moving it
# into a builder stage, would on its own have changed nothing at all.
#
# `kernel-headers` alone accounted for 141 of the backend's 200 OS-package HIGH
# findings, and it is a base-image package. The only way to drop it is to change
# the RUNTIME BASE IMAGE — hence the split below: build on the S2I builder
# image, ship on ubi9/nodejs-22-minimal (Red Hat's supported Node.js 22 runtime
# image, no toolchain). This mirrors frontend/Containerfile, which builds on
# ubi9/nodejs-22 and ships on ubi9/nginx-124.
#
# Do NOT "simplify" this back to a single stage, and do not assume a dnf line is
# responsible for a base-image package. Check %{INSTALLTIME} first.
FROM registry.access.redhat.com/ubi9/nodejs-22 AS builder

USER root
# Override these ARGs to force a specific binary URL (optional — auto-detected by default).
# When overriding a URL, the corresponding SHA256 arg is REQUIRED.
ARG OCP_CLIENT_URL=""
ARG OCP_CLIENT_SHA256=""
ARG OCP_MIRROR_URL=""
ARG OCP_MIRROR_SHA256=""

# All of these are already present in the ubi9/nodejs-22 base (see above), so
# this is in practice a no-op assertion that the builder has what it needs:
# curl/tar for the binary fetch, python3+make+gcc-c++ for node-gyp. It is kept
# because the builder stage genuinely depends on them and a future base-image
# slim-down must fail HERE, in the builder, rather than silently at `npm ci`.
RUN dnf install -y --setopt=install_weak_deps=false \
    ca-certificates tar python3 make gcc-c++ \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Bake oc and oc-mirror, resolved from Red Hat release channels (no hardcoded
# z-stream) and verified against each channel's own sha256sum.txt.
#
#   oc-mirror -> "latest"       global latest; required because operator listing
#                               ("--v2 list operators") does not exist in 4.21.x.
#   oc        -> "latest-4.22"  highest supported target minor; convenience only.
#                               Downloadable bundles resolve oc per selected
#                               target minor at request time, not from this layer
#                               (see getBinariesForExportArch in ocMirrorRuntime.js),
#                               so this layer never determines what a user receives.
#                               It read "latest-4.21" until Tranche 7C: that default
#                               predated 4.22 support and made the build print
#                               OC_RESOLVED_VERSION=4.21.36 while the product
#                               supported 4.22, which read as a version defect.
#
# Supported architectures: x86_64, aarch64 (arm64), ppc64le, s390x.
# Custom URL overrides require a matching SHA256 arg — never silently skip verification.
# The resolved versions/digests are written to /app/tools-provenance.env.
ARG OC_CHANNEL=latest-4.22
ARG OC_MIRROR_CHANNEL=latest
# Each fetch is CAPTURED FIRST and parsed afterwards, never piped straight into
# awk. Two reasons, both load-bearing:
#   1. `curl ... | awk '/^Name:/{print $2; exit}'` made awk close the pipe after
#      the first match, so curl died with EPIPE and printed
#      "curl: (23) Failure writing output to destination" on every single build
#      (observed: "passed 8192 returned 3583" against a 33 KB release.txt).
#   2. Worse than the noise: in a pipeline without pipefail the exit status is
#      awk's, so curl's status — 23, or a real 404/TLS/network failure — was
#      DISCARDED and `set -e` never saw it. The [ -n "$var" ] guards below are a
#      proxy for "did it work", and they cannot distinguish a TLS failure from a
#      404. A plain assignment from a non-pipelined substitution takes curl's own
#      status, so a genuine failure now aborts the build with curl's own message.
# The sha256sum.txt fetches used the same idiom and only escaped (23) because
# those files fit in the 64 KiB pipe buffer — latent, not safe. Do not
# reintroduce `| awk '...; exit'`, `| head -1` or `| grep -m1` here: all three
# close the pipe early and recreate this.
RUN set -e && \
    _arch="$(uname -m)" && \
    case "$_arch" in \
      x86_64)        _dir="x86_64" ;; \
      aarch64|arm64) _dir="aarch64" ;; \
      ppc64le)       _dir="ppc64le" ;; \
      s390x)         _dir="s390x" ;; \
      *) echo "FATAL: unsupported build architecture $_arch"; exit 1 ;; \
    esac && \
    if [ -n "${OCP_CLIENT_URL}" ] && [ -z "${OCP_CLIENT_SHA256}" ]; then \
      echo "FATAL: OCP_CLIENT_URL requires OCP_CLIENT_SHA256"; exit 1; \
    fi && \
    if [ -n "${OCP_MIRROR_URL}" ] && [ -z "${OCP_MIRROR_SHA256}" ]; then \
      echo "FATAL: OCP_MIRROR_URL requires OCP_MIRROR_SHA256"; exit 1; \
    fi && \
    _cbase="https://mirror.openshift.com/pub/openshift-v4/${_dir}/clients/ocp" && \
    _oc_base="${_cbase}/${OC_CHANNEL}" && \
    _mirror_base="${_cbase}/${OC_MIRROR_CHANNEL}" && \
    _oc_rel="$(curl -fsSL "${_oc_base}/release.txt")" && \
    _mirror_rel="$(curl -fsSL "${_mirror_base}/release.txt")" && \
    _oc_ver="$(printf '%s\n' "${_oc_rel}" | awk '/^Name:/{v=$2} END{print v}')" && \
    _mirror_ver="$(printf '%s\n' "${_mirror_rel}" | awk '/^Name:/{v=$2} END{print v}')" && \
    [ -n "${_oc_ver}" ] || { echo "FATAL: could not resolve oc version from ${_oc_base}"; exit 1; } && \
    [ -n "${_mirror_ver}" ] || { echo "FATAL: could not resolve oc-mirror version from ${_mirror_base}"; exit 1; } && \
    if [ -n "${OCP_CLIENT_SHA256}" ]; then _oc_check="${OCP_CLIENT_SHA256}"; else \
      _oc_sums="$(curl -fsSL "${_oc_base}/sha256sum.txt")" && \
      _oc_check="$(printf '%s\n' "${_oc_sums}" | awk '$2=="openshift-client-linux.tar.gz"{v=$1} END{print v}')"; fi && \
    if [ -n "${OCP_MIRROR_SHA256}" ]; then _mirror_check="${OCP_MIRROR_SHA256}"; else \
      _mirror_sums="$(curl -fsSL "${_mirror_base}/sha256sum.txt")" && \
      _mirror_check="$(printf '%s\n' "${_mirror_sums}" | awk '$2=="oc-mirror.tar.gz"{v=$1} END{print v}')"; fi && \
    [ -n "${_oc_check}" ] || { echo "FATAL: no SHA256 for openshift-client-linux.tar.gz"; exit 1; } && \
    [ -n "${_mirror_check}" ] || { echo "FATAL: no SHA256 for oc-mirror.tar.gz"; exit 1; } && \
    _oc_url="${OCP_CLIENT_URL:-${_oc_base}/openshift-client-linux.tar.gz}" && \
    _mirror_url="${OCP_MIRROR_URL:-${_mirror_base}/oc-mirror.tar.gz}" && \
    echo "Downloading oc ${_oc_ver} (${_dir}) from: ${_oc_url}" && \
    curl -fsSL "${_oc_url}" -o /tmp/oc.tgz && \
    echo "${_oc_check}  /tmp/oc.tgz" | sha256sum --check --strict && \
    tar -xzf /tmp/oc.tgz -C /usr/local/bin oc && chmod +x /usr/local/bin/oc && rm -f /tmp/oc.tgz && \
    echo "Downloading oc-mirror ${_mirror_ver} (${_dir}) from: ${_mirror_url}" && \
    curl -fsSL "${_mirror_url}" -o /tmp/oc-mirror.tgz && \
    echo "${_mirror_check}  /tmp/oc-mirror.tgz" | sha256sum --check --strict && \
    tar -xzf /tmp/oc-mirror.tgz -C /usr/local/bin oc-mirror && chmod +x /usr/local/bin/oc-mirror && rm -f /tmp/oc-mirror.tgz && \
    mkdir -p /app && { \
      echo "OC_RESOLVED_VERSION=${_oc_ver}"; \
      echo "OC_RESOLVED_SHA256=${_oc_check}"; \
      echo "OC_RESOLVED_CHANNEL=${OC_CHANNEL}"; \
      echo "OC_MIRROR_RESOLVED_VERSION=${_mirror_ver}"; \
      echo "OC_MIRROR_RESOLVED_SHA256=${_mirror_check}"; \
      echo "OC_MIRROR_RESOLVED_CHANNEL=${OC_MIRROR_CHANNEL}"; \
      echo "TOOLS_RESOLVED_ARCH=${_dir}"; \
    } > /app/tools-provenance.env && cat /app/tools-provenance.env

WORKDIR /app
COPY backend/package.json backend/package-lock.json* ./
# --omit=dev is preserved verbatim. better-sqlite3 is compiled from source here
# (the resulting tree contains build/Release/obj.target and sqlite3.a, not a
# downloaded prebuild), which is the whole reason a toolchain is needed at all.
# The compiled better_sqlite3.node links only libstdc++/libm/libgcc_s/libc, all
# of which the minimal runtime image provides, so the tree is portable across
# the stage boundary. Both stages are nodejs-22 from the same RHEL 9.8 module
# stream (node v22.23.2, NODE_MODULE_VERSION 127), so the native ABI matches.
RUN npm ci --omit=dev

# ---------------------------------------------------------------------------
# Runtime — Red Hat's Node.js 22 runtime image: no gcc, no kernel-headers
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal

USER root
# The minimal image already provides node, npm, bash, shadow-utils (useradd),
# findutils, which, tar, gzip, gpgme and ca-certificates. Two of those names
# are not the package you would guess, and a future slim-down that checks the
# obvious name will get a misleading answer:
#
#   df, chmod  -> coreutils-SINGLE, not coreutils. `rpm -q coreutils` reports
#                 "not installed" in this image even though /usr/bin/df exists.
#                 index.js spawns `df` by name (runDf) and installer.js spawns
#                 `chmod`, so coreutils-single is a hard runtime dependency.
#   curl       -> curl-MINIMAL. Sufficient: installer.js and
#                 openshiftInstaller.js only ever do `curl -fsSL <https url>`.
#   gzip       -> a separate package from tar. `tar -xzf` forks /usr/bin/gzip,
#                 and every tarball this app extracts (oc, oc-mirror,
#                 openshift-install) is .tar.gz, so tar alone is not enough.
#
# Exactly two runtime dependencies are missing from the base image:
#
#   util-linux      -> /sbin/runuser. backend/scripts/entrypoint.sh drops from
#                      root to UID 1001 with `runuser -u appuser`. runuser is in
#                      util-linux proper, NOT util-linux-core, so the full
#                      package is required. Removing this breaks startup.
#   openssh-clients -> ssh-keygen, spawned by backend/src/index.js for the
#                      SSH key generation endpoint.
#
# Nothing else from the old single-stage install list is needed at runtime:
# tar/gpgme/ca-certificates are already present, and python3/make/gcc-c++ were
# only ever build inputs.
# nodejs-nodemon is a DEVELOPMENT file-watcher that Red Hat ships inside the
# runtime base image. This container runs `node src/index.js` and never invokes
# nodemon, so it is pure attack surface (2 of the remaining OS HIGH findings).
# It is a leaf package: `microdnf remove --assumeno nodejs-nodemon` reports
# "Removing: 1 packages" with nothing else cascading. The `node --version`
# assertion immediately after is NOT decoration — if a future base image ever
# makes nodemon a dependency of the nodejs module, the removal would cascade
# and this RUN must fail the build rather than ship a Node-less image.
#
# The removal is guarded by `rpm -q` rather than run unconditionally. Measured:
# `microdnf remove -y nodejs-nodemon` against an image where it is already gone
# exits 1 with "error: No installed package matches 'nodejs-nodemon'", so an
# unconditional remove would break this build outright the day Red Hat stops
# shipping nodemon in the base — failing on the very change we want, with an
# error that reads like a typo rather than an instruction.
#
# Fail-loud is NOT weakened by that guard, because the contract asserted here
# is the END STATE, not the exit status of one command:
#   ! rpm -q nodejs-nodemon   nodemon must be absent, however it got that way.
#   node --version            a cascading removal that took Node with it fails
#                             the build instead of shipping a Node-less image.
# Both assertions are stronger than the bare `microdnf remove` they replace,
# which only ever proved that one invocation returned 0.
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 \
    util-linux openssh-clients \
    && if rpm -q nodejs-nodemon >/dev/null 2>&1; then microdnf remove -y nodejs-nodemon; fi \
    && ! rpm -q nodejs-nodemon >/dev/null 2>&1 \
    && node --version && npm --version \
    && microdnf clean all \
    && rm -rf /var/cache/yum /var/cache/dnf

# oc, oc-mirror and their recorded provenance cross the stage boundary as
# already-verified bytes. Verification (sha256sum --check --strict against each
# channel's own sha256sum.txt) happened in the builder and is NOT weakened here:
# a COPY of a file the builder refused to produce cannot happen, because the
# builder's RUN would have failed the build first.
COPY --from=builder /usr/local/bin/oc /usr/local/bin/oc-mirror /usr/local/bin/
COPY --from=builder /app/tools-provenance.env /app/tools-provenance.env

WORKDIR /app
# Only the production dependency tree crosses over — it was installed with
# `npm ci --omit=dev` in the builder.
#
# NOTE for the release gate. An earlier revision of this comment warned that
# shippedInstallScope() inspected only the FINAL stage and would therefore
# classify this copy as scope "all", auditing the backend WITH devDependencies.
# That is no longer true: both classifiers — scripts/release/axes/dependencies.mjs
# and shipped_install_scope() in scripts/security/tranche-security-gate.sh —
# now resolve the `--from=` stage and read ITS install flags, so this image
# classifies as "prod", which is what it actually ships. An unresolvable copy
# source still reports "all", because unknown provenance must over-report.
COPY --from=builder /app/node_modules ./node_modules
COPY backend/package.json ./
ARG CACHE_BUST=1
RUN echo "cache bust ${CACHE_BUST}" >/dev/null
COPY backend/src ./src
COPY backend/mock-data ./mock-data
# Shipped read-only data (arch-support matrices, parameter catalogs). This is
# NOT the runtime volume: docker-compose.yml mounts `backend-data` at /data and
# sets DATA_DIR=/data for the database, tools and oc-mirror archives. The two
# must stay distinct — the backend used to resolve this data as
# `backend/src/../../data`, which in this image is `/data`, so it read the empty
# runtime volume and reported "No architecture-support matrix is available" for
# every supported minor. OAA_CANONICAL_DATA_DIR states the location explicitly;
# see backend/src/canonicalDataRoot.js.
COPY data ./data
ENV OAA_CANONICAL_DATA_DIR=/app/data
COPY shared /shared
COPY backend/scripts/entrypoint.sh /app/entrypoint.sh
COPY --from=build-info /tmp/build-env.sh /app/build-env.sh
RUN chmod +x /app/entrypoint.sh && chown -R 1001:0 /app \
    && useradd -r -u 1001 -g 0 -o -M -d /app appuser 2>/dev/null || true

# --- PROOF A: bind the shipped image to the source candidate --------------
#
# Without these, the only provenance an image carries is
# org.opencontainers.image.revision INHERITED from the UBI base — which
# describes Red Hat's build commit (e573c607…, not a commit in this
# repository), not ours. The certification harness detects that inheritance
# (the label equals the base's `vcs-ref`) and refuses it, so every container
# axis reports INCOMPLETE until these labels exist.
#
# ARGs are PER-STAGE: the `ARG APP_GIT_SHA` near the top lives in the
# build-info stage and does not reach here, so it must be redeclared.
#
# The defaults are EMPTY STRINGS, not "unknown". An empty label value reads as
# absent to both provenance implementations, so an ad-hoc `podman build`
# behaves exactly as it does today — unbound, falling through to the build
# manifest — rather than stamping a fictitious revision that someone would
# later have to diagnose. scripts/release/buildImages.mjs supplies real values.
ARG APP_GIT_SHA=""
ARG OAA_CANDIDATE_ID=""
ARG OAA_BUILD_SUPPLIED_REVISION="false"
LABEL org.opencontainers.image.revision="$APP_GIT_SHA" \
      io.oaa.candidate-id="$OAA_CANDIDATE_ID" \
      io.oaa.build-supplied-revision="$OAA_BUILD_SUPPLIED_REVISION"

ENV NODE_ENV=production
EXPOSE 4000
# Entrypoint runs as root only to chown DATA_DIR for UID 1001, then runs Node as non-root.
CMD ["/app/entrypoint.sh"]
