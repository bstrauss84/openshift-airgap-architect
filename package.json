{
  "name": "openshift-airgap-architect",
  "version": "2.1.0-dev",
  "description": "OpenShift Airgap Installation Configuration Generator",
  "private": true,
  "scripts": {
    "sync-catalogs": "node scripts/sync-catalogs.js",
    "sync-catalogs:check": "node scripts/sync-catalogs.js --check",
    "sync-catalogs:preview": "node scripts/sync-catalogs.js --dry-run",
    "sync-catalogs:verbose": "node scripts/sync-catalogs.js --verbose",
    "sync-docs-index": "node scripts/sync-docs-index.js",
    "sync-docs-index:check": "node scripts/sync-docs-index.js --check",
    "sync-docs-index:preview": "node scripts/sync-docs-index.js --dry-run",
    "validate-catalogs": "node scripts/validate-catalog.js data/params",
    "validate-authority": "node scripts/validate-param-authority.js",
    "check:supported-minors": "node scripts/validate-supported-minors.mjs",
    "check:version-lists": "node scripts/validate-version-lists.mjs",
    "check:citation-minor": "node scripts/validate-catalog-citation-minor.js --report",
    "check:citation-minor:strict": "node scripts/validate-catalog-citation-minor.js --strict",
    "check:app-version": "node scripts/validate-app-version.mjs",
    "set:app-version": "node scripts/set-app-version.mjs",
    "test:app-version": "node --test scripts/validate-app-version.test.mjs",
    "test:tooling": "node --test scripts/*.test.js scripts/*.test.mjs scripts/minor/**/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/billstrauss/openshift-airgap-architect.git"
  },
  "author": "Bill Strauss",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "js-yaml": "^5.2.1"
  }
}
