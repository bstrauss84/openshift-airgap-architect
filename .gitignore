# Backend-downloaded installers and stream cache (do not commit)
data/tools/
data/cache/
# Ignore unknown paths under data/ but keep tracked canonical trees (git cannot re-include children if /data/ is ignored).
/data/*
!/data/docs-index/
!/data/docs-index/**
!/data/params/
!/data/params/**
# Global oc-mirror v2 ImageSetConfiguration structural authority (DOC-166). Canonical
# tracked data, not runtime scratch: backend/test/imageset-config-schema.test.js reads it.
!/data/oc-mirror-v2/
!/data/oc-mirror-v2/**
# Architecture-support matrix (D3 / DOC-156). Canonical tracked data:
# scripts/validate-arch-support.js and its test read it, and it is referenced by
# docs/minor-release/4.22/TRANCHE_2_ASSET_AUTHORING_4.22.md. Without this
# re-inclusion the deny-by-default /data/* rule above would silently drop it.
!/data/arch-support/
!/data/arch-support/**
# Platform x installation-methodology scenario surface (DOC-202). Canonical
# tracked data: scripts/validate-scenario-support.js and its test read it, and
# npm run validate-authority runs that guard. Same deny-by-default trap as the
# matrix above — without this re-inclusion /data/* would silently drop it and
# the guard would fail on a fresh clone.
!/data/scenario-support/
!/data/scenario-support/**
**/openshift-install-*
**/openshift-install-*.tar.gz
# When DATA_DIR is backend/ (e.g. local dev)
backend/tools/
backend/cache/

# E2E matrix outputs (Workstream K; may contain placeholder secrets)
e2e-artifacts
e2e-artifacts/
**/e2e-artifacts
**/e2e-artifacts/

# E2E doc crawl outputs (regeneratable; do not commit)
docs/e2e-examples/snippets/
docs/e2e-examples/SNIPPETS_INVENTORY.md
docs/e2e-examples/nmstate/

