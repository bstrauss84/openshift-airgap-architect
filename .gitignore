*_chat_history.txt
*.chat.txt
/local-docs/
backend/tmp-installer-test/
# Repository-root scratch directory. Tests that write here must not be able to
# dirty the working tree: a dirty tree changes the release candidate id and
# invalidates certification evidence bound to it (the last full run was recorded
# as "f860d7db...+dirty" for exactly this class of reason).
/tmp/

# Playwright E2E test artifacts
test-results/
playwright-report/
playwright/.cache/
e2e-results/

# Test coverage reports
coverage/
**/coverage/
*.lcov

# Release-certification evidence (scripts/release/certify.mjs).
# Generated per run and regenerable; large (SBOMs, scanner reports, suite logs).
# Committing it would also make the tree dirty on every run, which changes the
# candidate id and invalidates the evidence just produced. Retention policy:
# CI uploads summary.json/summary.md/axes as workflow artifacts, and a release
# attaches them to the release bundle. The harness and its waiver file ARE
# tracked (scripts/release/**) — only generated output is ignored.
release-certification/

# Research and analysis artifacts (keep local only)
.research/

# Claude Code user-specific settings (migrated from .git/info/exclude)
.claude/settings.local.json
.claude/hooks/*.sh
!.claude/hooks/shared-*.sh

# Additional temporary editor files
*.swp
*.swo
*~
.*.sw?

# OS-specific files
Thumbs.db
desktop.ini

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local manual QA evidence — never commit/push
docs/MANUAL_TESTING_CHECKLIST.md
docs/MANUAL_TESTING_CHECKLIST_*.md
